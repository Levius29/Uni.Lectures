{
  "name": "intarsi-lecture",
  "version": "0.1.0",
  "description": "Corso Conservativa 4: lezioni come composizioni HyperFrames navigabili",
  "scripts": {
    "dev": "vite",
    "compose": "node scripts/compose.mjs",
    "build": "tsc --noEmit && node scripts/compose.mjs && vite build",
    "standalone": "node scripts/compose.mjs && node scripts/standalone.mjs",
    "preview": "vite preview",
    "pretest": "node scripts/check-skills.mjs && npm run lint:hf",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "lint:hf": "node scripts/compose.mjs && node scripts/hf-lint.mjs",
    "present": "node scripts/compose.mjs && hyperframes present public/compositions/01",
    "studio": "node scripts/compose.mjs && hyperframes preview public/compositions/01",
    "images:prepare": "node scripts/prepare-clinical.mjs",
    "skills:check": "node scripts/check-skills.mjs",
    "skills:sync": "scripts/sync-impeccable.sh"
  },
  "keywords": [],
  "type": "module",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@hyperframes/core": "0.8.138",
    "@hyperframes/player": "0.8.138",
    "gsap": "^3.15.0"
  },
  "devDependencies": {
    "@playwright/cli": "^0.1.21",
    "@playwright/mcp": "^0.0.82",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "hyperframes": "0.8.138",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  }
}
